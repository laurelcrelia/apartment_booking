# Copy to .env and fill in. Docker Compose reads .env automatically; it is
# git-ignored and kept out of Docker images, so secrets never get committed.
#
# Generate a fresh .env with a random password:
#   printf 'RABBITMQ_PASSWORD=%s\n' "$(openssl rand -hex 24)" > .env

# RabbitMQ login for the relay, the consumer and the management UI.
# Letters and digits only: the password goes into an amqp:// URL.
# RabbitMQ applies it only when its volume is first created; see "Secrets" in README.md.
RABBITMQ_USER=booking
RABBITMQ_PASSWORD=
